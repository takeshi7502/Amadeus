# Vercel Environment Variables; never put real secrets in this tracked file.
TURSO_DATABASE_URL=libsql://YOUR-DATABASE-YOUR-ORG.turso.io
TURSO_AUTH_TOKEN=
AMADEUS_SESSION_SECRET=
# Admin login only; guests can open and chat without a password.
AMADEUS_WEB_PASSWORD=
AMADEUS_CHAT_MODEL=default/YOUR_MODEL_NAME
AMADEUS_API_URL=https://YOUR_PROVIDER_HOST/v1
AMADEUS_API_KEY=
AMADEUS_API_TYPE=chat_completions
# Accept all domains attached to the Vercel project; optionally restrict with a comma-separated list.
AMADEUS_ALLOWED_HOSTS=*
AMADEUS_WEB_SEARCH_ENABLED=true
