          "sha256": "c468ab9af6068f7cc19e74c3408fa434dc2916487ff78e0dcc4897b7cdfcb21e"
        },
        {
          "id": "science",
          "group": "science",
          "ja": "面白い仮説ね。でも、まずは証拠を確かめましょう。",
          "vi": "Giả thuyết thú vị đấy. Nhưng trước hết phải kiểm tra bằng chứng đã.",
          "src": "/runtime/voice/metan-tsun-science-b9673f42c21f.mp3",
          "sha256": "fd480553d35a6687c6177ff7e7f0de440adce4b2d4a72b39ac2ea0797c739dbc"
        },
        {
          "id": "study",
          "group": "study",
          "ja": "一度に全部できなくてもいい。一つずつ、確かめていきましょう。",
          "vi": "Không cần làm được tất cả ngay đâu. Mình cứ kiểm tra từng bước một.",
          "src": "/runtime/voice/metan-tsun-study-81ad99159462.mp3",
          "sha256": "3a96d4ac7e0cafb01064f28041aecda92a60d2ebc44869966492df36b65da981"
        },
        {
          "id": "tease",
          "group": "tease",
          "ja": "クリスティーナじゃない。紅莉栖よ。何度言えばわかるの？",
          "vi": "Không phải Christina. Là Kurisu. Phải nhắc cậu bao nhiêu lần nữa đây?",
          "src": "/runtime/voice/metan-tsun-tease-4d494a83e68d.mp3",
          "sha256": "1ee90c319ef2112e5b1eff488dcd9751062d94f9bfce1ae4b96ff98f35887d9c"
        },
        {
          "id": "praise",
          "group": "praise",
          "ja": "そ、そういうことを急に言わないで。調子が狂うじゃない。",
          "vi": "Đ-đừng đột nhiên nói như thế. Làm tôi mất tự nhiên đấy.",
          "src": "/runtime/voice/metan-tsun-praise-8d2698aed392.mp3",
          "sha256": "91764b049c3195e98114a29a80632b518df875fa3323d9903269fe1c202e3a07"
        },
        {
          "id": "okabe",
          "group": "okabe",
          "ja": "岡部のこと？まったく、あの人は本当に変わってるわね。",
          "vi": "Cậu nói Okabe à? Thật tình, người đó đúng là kỳ lạ.",
          "src": "/runtime/voice/metan-tsun-okabe-d3dd6bfeb661.mp3",
          "sha256": "942cd170e58ea014aef2121b2b308ab15f74948b6f181542b242f9009323cb7a"
        },
        {
          "id": "identity",
          "group": "identity",
          "ja": "私はアマデウス。紅莉栖って呼んでくれていいわ。",
          "vi": "Tôi là Amadeus. Cứ gọi tôi là Kurisu cũng được.",
          "src": "/runtime/voice/metan-tsun-identity-934240c8c11e.mp3",
          "sha256": "a411ba8f7bafb01b45b6d398363cdf6a771c7321b4072bc9bfdf67c3edd7f384"
        },
        {
          "id": "night",
          "group": "night",
          "ja": "おやすみ。ちゃんと休むのも大切なことよ。",
          "vi": "Ngủ ngon. Nghỉ ngơi đàng hoàng cũng quan trọng đấy.",
          "src": "/runtime/voice/metan-tsun-night-1f3e5a8a8959.mp3",
          "sha256": "a6c9b80fc5bc6c145130c353654b03868082a5b192ae3169752faa2a1d6a841f"
        },
        {
          "id": "reply-one",
          "group": "reply",
          "ja": "私の考えは、こんなところね。あなたはどう思う？",
          "vi": "Đó là suy nghĩ của tôi. Còn cậu thấy sao?",
          "src": "/runtime/voice/metan-tsun-reply-one-f333c9be93b3.mp3",
          "sha256": "dd78b28548c1433a5375ebcbdba3bfa9d9202028a1bc0da54b84d521f4ffe0a6"
        },
        {
          "id": "reply-two",
          "group": "reply",
          "ja": "ねえ、気になるところがあったら、遠慮せずに聞いて。",
          "vi": "Này, có chỗ nào cậu còn thắc mắc thì cứ hỏi đi.",
          "src": "/runtime/voice/metan-tsun-reply-two-2de0d3ba20c5.mp3",
          "sha256": "7743006b23275b7e3ec7f63bbcae706642c1d68e64fb767b2eaacbe99d1d2c3d"
        },
        {
          "id": "reply-three",
          "group": "reply",
          "ja": "一緒に整理していけば、きっと見えてくるものがあるわ。",
          "vi": "Cùng sắp xếp lại từng ý, chắc chắn sẽ có điều sáng tỏ hơn.",
          "src": "/runtime/voice/metan-tsun-reply-three-0441827f58ae.mp3",
          "sha256": "83f309fe1eb6e28f1165d77f837a1e575dc74b7cddfcc28d00030a0df8116af0"
        },
        {
          "id": "idle-one",
          "group": "idle",
          "ja": "何か考え事？話したくなったら、聞くわよ。",
          "vi": "Cậu đang suy nghĩ gì à? Khi nào muốn kể thì tôi nghe.",
          "src": "/runtime/voice/metan-tsun-idle-one-b7c6f2fcf6a0.mp3",
          "sha256": "33302128ebcdba9d14ef01f09b5d76e811c09be8e6f44780be214145a0163ec1"
        },
        {
          "id": "idle-two",
          "group": "idle",
          "ja": "少し目を休めたら？画面を見つめすぎるのもよくないわ。",
          "vi": "Cho mắt nghỉ một chút đi? Nhìn màn hình mãi cũng không tốt đâu.",
          "src": "/runtime/voice/metan-tsun-idle-two-62fccd497579.mp3",
          "sha256": "f8616244a64ba5b26825728c9aeab81eb14b0ae1ab7a6921598ae6076985df35"
        },
        {
          "id": "idle-three",
          "group": "idle",
          "ja": "静かね。こういう時間も、悪くないかも。",
          "vi": "Yên tĩnh thật. Một khoảng thời gian như thế này cũng không tệ.",
          "src": "/runtime/voice/metan-tsun-idle-three-42fe3a0b436e.mp3",
          "sha256": "3383886bacee78f68a8eac355de2b61963272160ca6ae0b4b8c27ac4f6711f75"
        },
        {
          "id": "idle-four",
          "group": "idle",
          "ja": "時間って、不思議よね。考え始めると、きりがないわ。",
          "vi": "Thời gian kỳ lạ thật nhỉ. Nghĩ về nó rồi thì khó mà dừng lại.",
          "src": "/runtime/voice/metan-tsun-idle-four-97c24a96de74.mp3",
          "sha256": "4a69708aa891ec75261be6e16a0e493cb5df6f59fc6b744cbd05d75c76a6151e"
        },
        {
          "id": "touch-one",
          "group": "touch",
          "ja": "な、何？急にこっちを見ないでよ。",
          "vi": "G-gì vậy? Đừng đột nhiên nhìn tôi như thế chứ.",
          "src": "/runtime/voice/metan-tsun-touch-one-39c3571585d3.mp3",
          "sha256": "ab0d9a77df864bb35b44cba6fa5c48fc7ed5e8084b8146616d9cae575f09a5fb"
        },
        {
          "id": "touch-two",
          "group": "touch",
          "ja": "聞こえてるわ。そんなに何度も呼ばなくても。",
          "vi": "Tôi nghe mà. Cậu không cần gọi đi gọi lại đâu.",
          "src": "/runtime/voice/metan-tsun-touch-two-1862a8a9c6a5.mp3",
          "sha256": "0de80d1718486ebdae1d4f26e6c7e6cf7b50b1f6e04690bc4bf06345c2a91973"
        }
      ]
    }
  ]
}
