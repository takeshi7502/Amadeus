{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "python tools/prepare_vercel.py",
  "regions": ["hnd1"],
  "functions": {"app.py": {"maxDuration": 180}},
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "same-origin"},
      {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"}
    ]},
    {"source": "/api/(.*)", "headers": [{"key": "Cache-Control", "value": "no-store"}]},
    {"source": "/runtime/branding/logo.webp", "headers": [{"key": "Content-Type", "value": "image/webp"}]},
    {"source": "/runtime/fonts/(.*)", "headers": [{"key": "Content-Type", "value": "font/ttf"}]},
    {"source": "/runtime/voice/bank.json", "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]}
  ]
}
